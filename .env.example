# ==========================================
# LifePilot AI — Environment Configuration
# ==========================================

# Backend & Database
DATABASE_URL=sqlite:///./lifepilot.db
# For PostgreSQL deployment:
# DATABASE_URL=postgresql://user:password@localhost:5432/lifepilot_db

# CORS Allowed Origins (Comma-separated or list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# AI Provider Configuration
# Options: "demo" (Default deterministic agent with live DB tools), "openai", "anthropic", "aws_bedrock"
AI_PROVIDER=demo

# Optional: Real OpenAI API Configuration
OPENAI_API_KEY=

# Optional: Real Anthropic Claude API Configuration
ANTHROPIC_API_KEY=

# Optional: Real AWS Bedrock Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# MCP Server Configuration
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_SERVER_NAME=lifepilot-mcp

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api
